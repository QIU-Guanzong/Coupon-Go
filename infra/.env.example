# ============================================================
# GOOGLE 凭据在本地 infra/.env 配置，不进仓库、不推送。
# 上线前必须：
# 1. 在 Google Cloud 新建自己的项目，生成新的 API Key 和 OAuth Client ID；
# 2. 把新值填进本地 .env；
# 3. 给 API Key 加 API 限制（仅限 Places API）。
# 绝不要把真实 Key 提交进 Git 仓库。
# ============================================================
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID_1=
GOOGLE_OAUTH_CLIENT_ID_2=

# 后端
COUPON_GO_ENV=dev
SECRET_KEY=change-me-to-a-long-random-secret
# CORS 白名单（逗号分隔）：开发环境留空默认 *；非开发环境留空默认不信任任何来源，生产必须显式列出前端域名。
CORS_ORIGINS=
DATABASE_URL=postgresql://coupon_go:coupon_go@localhost:5432/coupon_go
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 积分规则（演示规则，可配置）
POINTS_CLAIM=10
POINTS_REDEEM=20
POINTS_REVIEW=15

# QR 倒计时与扫码上限
QR_TTL_SECONDS=900
SCAN_DAILY_LIMIT=200
OTP_TTL_SECONDS=600

# Flutter App 要连的后端地址（真机调试改成电脑局域网 IP）
API_BASE_URL=http://localhost:8000

# 支付（线 C：Stripe 测试模式；不接真实商户号、不写真实密钥）
# 未设置时后端用本地测试模拟器；设置时只接受 sk_test_… 测试密钥。
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MINUTES=15

# 后台定时任务 M1（见 docs/SCHEDULER.md）：过期退款 / 砍价结算 / 超时关闭 / 返现 sweep
# SCHEDULER_ENABLED：1 开 / 0 关；不填时开发环境默认开，非开发环境默认关并在启动时明确警告。
SCHEDULER_ENABLED=
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_CASHBACK_BATCH_SIZE=100
SCHEDULER_LOCK_LEASE_SECONDS=600
